# Copy this file to .env and fill it in. .env is git-ignored - never commit it.
#
# Quote every value. Unquoted all-digit values are emitted as C numbers rather
# than strings, which would silently break an all-numeric WiFi password.

WIFI_SSID="Your Network Name"
WIFI_PASSWORD="your-wifi-password"

# Shown above the countdown. Separate multiple titles with | and they cycle.
# Any title too wide for the screen scrolls marquee-style while it is shown,
# and gets at least two full scrolls before the next title takes over.
#
# Colour markup: [name] sets a colour, [/] returns to white.
#   named  : red green blue yellow cyan magenta white orange grey skyblue pink
#   custom : [#RRGGBB] for anything else
# An unrecognised tag is drawn as literal text rather than silently dropped,
# so a typo is visible instead of eating the words after it.
#
# Note: the panel is RGB565, so colours are quantised to 5 bits per channel and
# brand hex values often read duller than the named equivalents. Plain [blue] is
# very dark; [skyblue] or [#00A4EF] is better. A brand red such as [#D5002B] is
# noticeably muddier than plain [red], which is full brightness.
EVENT_NAME="Launch Day"
# EVENT_NAME="[red]Westpac[/] + [#00A4EF]Microsoft[/] Hackathon|Doors open 6pm"

# Minimum time each title is shown, in milliseconds. Scrolling titles stay up
# for at least two full scrolls, which is usually longer than this.
TITLE_DWELL_MS=5000

# Blank pause between one title finishing and the next appearing.
TITLE_GAP_MS=300

# ISO-8601 with an EXPLICIT UTC offset or a trailing Z.
# Offset-naive values are rejected at build time, because an ambiguous
# countdown target is worse than a failed build.
#   "2026-11-15T09:00:00+11:00"   Sydney
#   "2026-11-15T09:00:00Z"        UTC
EVENT_DATETIME="2026-11-15T09:00:00+11:00"

NTP_SERVER_1="0.pool.ntp.org"
NTP_SERVER_2="1.pool.ntp.org"
NTP_SERVER_3="2.pool.ntp.org"

# Screen brightness, 0-255. Lower materially extends the 120 mAh battery.
BRIGHTNESS=200

# Which speaker this unit drives. Hats cannot be detected at runtime, so the
# fitted hardware has to be named here or it stays silent and the quiet
# built-in buzzer is used instead. This is the default only: it can also be
# changed on a running device with the 'p' serial command.
#   INTERNAL  built-in buzzer on G2
#   HAT_SPK   SPK HAT, analog PAM8303 (G26 audio, G0 enable)
#   HAT_SPK2  SPK HAT2, I2S MAX98357 (G25 data, G26 BCK, G0 WS)
#   NONE      no audio output
SPEAKER="INTERNAL"

# Master switch for the Grove lights. Off unless you have pixels wired up.
LED_ENABLED="false"

# One to sixteen addressable RGB pixels on the Grove connector (a 7-pixel
# NeoPixel Jewel works). NEOPIXEL uses the usual GRB order at 800 kHz. Classic
# v1 FLORA pixels require NEOPIXEL_V1 for RGB order at 400 kHz. Set
# LED_TYPE="NONE" to disable the output.
# LED_BRIGHTNESS is the R/G/B channel level used to produce white, 1 to 255.
LED_TYPE="NEOPIXEL"
LED_COUNT=1
LED_PIN=32
LED_BRIGHTNESS=64

# Fixed local offset and daily white-light schedule. Times use 24-hour HH:MM.
# LOCAL_UTC_OFFSET is the default only: the time zone can also be picked from a
# list on a running device with the 'z' serial command.
LOCAL_UTC_OFFSET="+10:00"
LED_ON_TIME="08:00"
LED_OFF_TIME="18:00"

# Room messaging (see docs/messaging.md). With MQTT_HOST set, the unit keeps
# WiFi up after the sync and joins the broker to take commands from teams'
# agents. Set MQTT_HOST="" to disable messaging entirely.
MQTT_HOST="192.168.8.1"
MQTT_PORT=1883
# OTA auth for wireless firmware updates. Keep the clear password in .env.ota
# (generated by scripts/setup_ota.ps1); this file carries only the lowercase
# MD5 hash of that password. Leave blank to keep OTA disabled.
OTA_PASSWORD_HASH=""
# Mixed into each unit's four-digit claim code. Change it to reissue every code.
CLAIM_SALT="showcase"
# The event AP's fixed 2.4 GHz channel. The ESP-NOW bridge broadcasts on it.
ESPNOW_CHANNEL=6

# Pin this unit's voice instead of deriving it from the MAC address.
# 0 = root, 1 = fifth, 2 = melody. See docs/fanfare.md before using it.
# FORCE_VOICE=1
