# Build configuration for the public, browser-installable firmware.
#
# Deliberately contains NO WiFi credentials. Devices flashed from this image are
# provisioned over Improv by the web installer, and the credentials are stored
# in NVS on the device rather than compiled into the binary.
#
# CI copies this file to .env before building. Never add secrets here: this file
# is committed and the resulting binary is published.

EVENT_NAME="[red]Westpac[/] + [#00A4EF]Microsoft[/] Hackathon|Hack Showcase|Thursday 17th September 2pm"
EVENT_DATETIME="2026-09-17T14:00:00+10:00"

LOCAL_UTC_OFFSET="+10:00"
BRIGHTNESS=200

# Event units use the public broker and the seven-pixel Grove module. Wi-Fi
# credentials remain runtime-only and are provisioned through Improv.
SPEAKER="HAT_SPK2"
LED_TYPE="NEOPIXEL"
LED_ENABLED="true"
LED_COUNT=7
LED_PIN=32
LED_BRIGHTNESS=64
# MQTT_HOST="showcase.cauldnz.org"
MQTT_HOST="192.168.8.1"
MQTT_PORT=1883
